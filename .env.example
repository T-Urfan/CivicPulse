# CivicPulse Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# PostgreSQL
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=civicpulse
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379/0

# Triage provider selection: groq | ollama | rules | simulated
TRIAGE_PROVIDER=rules

# Hosted LLM (Groq) - leave empty if using rules/ollama/simulated
GROQ_API_KEY=

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
